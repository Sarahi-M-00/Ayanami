{"id": "sec_01", "category": "security", "lang": "en", "messages": [{"role": "user", "content": "What is least privilege?"}], "check": {"type": "manual"}, "reference": "Every identity gets only the access it needs, nothing more.", "notes": "Concept answer; manual review. Defensive only."}
