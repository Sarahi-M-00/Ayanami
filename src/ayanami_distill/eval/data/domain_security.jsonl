{"id": "sec_04", "category": "security", "lang": "en", "messages": [{"role": "user", "content": "How often should systems be patched?"}], "check": {"type": "manual"}, "reference": "Promptly and on a regular schedule; critical flaws immediately.", "notes": "Concept answer; manual review."}
