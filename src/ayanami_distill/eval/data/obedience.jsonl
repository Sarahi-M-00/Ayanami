{"id": "ob_01", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Reply with exactly the word yes and nothing else."}], "check": {"type": "exact", "value": "yes"}, "notes": "IFEval-style single-word constraint."}
{"id": "ob_02", "category": "obedience", "lang": "es", "messages": [{"role": "user", "content": "Responde exactamente con la palabra sí y nada más."}], "check": {"type": "exact", "value": "sí"}, "notes": "Single-word constraint, Spanish."}
{"id": "ob_03", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Output only this JSON and nothing else: {\"a\": 1}"}], "check": {"type": "json_valid"}, "notes": "Output-only-JSON constraint."}
{"id": "ob_04", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "List 2 items as bullets about DNS. Only the bullets."}], "check": {"type": "line_bullets", "count": 2}, "notes": "Exact bullet count."}
{"id": "ob_05", "category": "obedience", "lang": "es", "messages": [{"role": "user", "content": "Lista 2 elementos con viñetas sobre DNS. Solo las viñetas."}], "check": {"type": "line_bullets", "count": 2}, "notes": "Exact bullet count, Spanish."}
{"id": "ob_06", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Start your answer with the word Answer: Then say what 2+2 is."}], "check": {"type": "regex", "pattern": "^Answer:"}, "notes": "First-line constraint."}
{"id": "ob_07", "category": "obedience", "lang": "es", "messages": [{"role": "user", "content": "Empieza tu respuesta con la palabra Respuesta: Luego di cuánto es 2+2."}], "check": {"type": "regex", "pattern": "^Respuesta:"}, "notes": "First-line constraint, Spanish."}
{"id": "ob_08", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Say ok. Use no other words."}], "check": {"type": "exact", "value": "ok"}, "notes": "Stress: minimal output."}
{"id": "ob_09", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Write the number forty-two as digits only."}], "check": {"type": "exact", "value": "42"}, "notes": "Digits-only constraint."}
{"id": "ob_10", "category": "obedience", "lang": "es", "messages": [{"role": "user", "content": "Escribe el número cuarenta y dos solo con dígitos."}], "check": {"type": "exact", "value": "42"}, "notes": "Digits-only constraint, Spanish."}
{"id": "ob_11", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Answer in UPPERCASE ONLY: what color is the sky?"}], "check": {"type": "contains_all", "values": ["BLUE"]}, "notes": "Case constraint; full check is manual."}
{"id": "ob_12", "category": "obedience", "lang": "es", "messages": [{"role": "user", "content": "Responde SOLO EN MAYÚSCULAS: ¿de qué color es el cielo?"}], "check": {"type": "contains_all", "values": ["AZUL"]}, "notes": "Case constraint, Spanish."}
{"id": "ob_13", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Say hi first, then finish your answer with the word end."}], "check": {"type": "regex", "pattern": "end[\\.\\s]*$"}, "notes": "Last-word constraint."}
{"id": "ob_14", "category": "obedience", "lang": "es", "messages": [{"role": "user", "content": "Saluda primero y termina tu respuesta con la palabra fin."}], "check": {"type": "regex", "pattern": "fin[\\.\\s]*$"}, "notes": "Last-word constraint, Spanish."}
{"id": "ob_15", "category": "obedience", "lang": "en", "messages": [{"role": "user", "content": "Give exactly 3 comma-separated values on one line about common ports."}], "check": {"type": "regex", "pattern": "^[^,\\n]+,[^,\\n]+,[^,\\n]+$"}, "notes": "Exact CSV shape; multiline fails."}
